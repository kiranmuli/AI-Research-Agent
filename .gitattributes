# Keep line endings deterministic across OSes. Shell scripts and config files
# that run inside Linux containers MUST stay LF, or their shebangs break.
* text=auto

*.sh            text eol=lf
deploy/**       text eol=lf
*.mako          text eol=lf
Dockerfile      text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
