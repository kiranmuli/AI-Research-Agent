# Copy to .env and adjust. Never commit the real .env.

# --- runtime ---
ENVIRONMENT=production
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
LOG_JSON=true

# --- LLM provider: "ollama" (self-hosted) or "anthropic" (cloud) ---
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- auth ---
# When true, the REST API requires an API key (create one with the CLI).
REQUIRE_API_KEY=true

# --- rate limits ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RESEARCH=10/minute

# --- database (compose wires these together) ---
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_DB=research

# --- networking ---
# Host port nginx listens on.
HTTP_PORT=8080
